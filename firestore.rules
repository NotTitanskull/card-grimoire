rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    function isNonemptyString(value) {
      return value is string && value.matches('.*\\S.*');
    }

    function isSafeNonnegativeInteger(value) {
      return value is int
        && value >= 0
        && value <= 9007199254740991;
    }

    function isValidCard(card) {
      let fields = [
        'scryfallId', 'oracleId', 'name', 'setCode', 'setName',
        'collectorNumber', 'typeLine', 'rarity', 'imageUrl', 'finishes'
      ];

      return card is map
        && card.keys().hasAll(fields)
        && card.keys().hasOnly(fields)
        && isNonemptyString(card.scryfallId)
        && (card.oracleId == null || isNonemptyString(card.oracleId))
        && isNonemptyString(card.name)
        && isNonemptyString(card.setCode)
        && isNonemptyString(card.setName)
        && isNonemptyString(card.collectorNumber)
        && card.typeLine is string
        && card.rarity is string
        && card.imageUrl is string
        && card.finishes is list
        && card.finishes.size() >= 1
        && card.finishes.size() <= 3
        && card.finishes.hasOnly(['nonfoil', 'foil', 'etched']);
    }

    function isValidInventoryEntry(data) {
      let fields = [
        'card', 'quantity', 'condition', 'finish',
        'purchasePriceMinor', 'currency', 'favorite',
        'availableForTrade', 'binderQuantities',
        'createdAt', 'updatedAt'
      ];

      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields.concat(['assignedQuantity', 'lastBinderId']))
        && isValidCard(data.card)
        && isSafeNonnegativeInteger(data.quantity)
        && data.quantity > 0
        && data.condition in [
          'Near Mint',
          'Lightly Played',
          'Moderately Played',
          'Heavily Played',
          'Damaged'
        ]
        && data.finish in ['nonfoil', 'foil', 'etched']
        && data.finish in data.card.finishes
        && (
          data.purchasePriceMinor == null
          || isSafeNonnegativeInteger(data.purchasePriceMinor)
        )
        && data.currency == 'USD'
        && data.favorite is bool
        && data.availableForTrade is bool
        && data.binderQuantities is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidEntry(data) {
      return isValidInventoryEntry(data)
        && data.binderQuantities.size() == 0
        && !data.keys().hasAny(['assignedQuantity', 'lastBinderId']);
    }

    function isValidBinderChange(userId, before, after) {
      let binderId = after.lastBinderId;
      let oldCopies = before.binderQuantities.get(binderId, 0);
      let newCopies = after.binderQuantities.get(binderId, 0);
      let oldTotal = before.get('assignedQuantity', 0);

      return isNonemptyString(binderId)
        && binderId.matches('[^/]+')
        && after.binderQuantities.diff(before.binderQuantities).affectedKeys().hasOnly([binderId])
        && isSafeNonnegativeInteger(newCopies)
        && (
          (newCopies == 0 && !(binderId in after.binderQuantities))
          || (newCopies > 0
            && exists(/databases/$(database)/documents/users/$(userId)/binders/$(binderId)))
        )
        && isSafeNonnegativeInteger(after.assignedQuantity)
        && after.assignedQuantity == oldTotal - oldCopies + newCopies
        && after.assignedQuantity <= after.quantity;
    }

    match /users/{userId}/inventory/{entryId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidEntry(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
        && isValidInventoryEntry(request.resource.data)
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'quantity', 'condition', 'finish', 'purchasePriceMinor',
              'currency', 'favorite', 'availableForTrade', 'updatedAt'
            ])
            && request.resource.data.quantity >= resource.data.get('assignedQuantity', 0)
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'binderQuantities', 'assignedQuantity', 'lastBinderId', 'updatedAt'
            ])
            && isValidBinderChange(userId, resource.data, request.resource.data)
          )
        );

      allow delete: if isOwner(userId);
    }

    // Keep access for existing app versions during the inventory migration.
    match /users/{userId}/collectionEntries/{entryId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidEntry(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
        && isValidEntry(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantity',
          'condition',
          'finish',
          'purchasePriceMinor',
          'currency',
          'favorite',
          'availableForTrade',
          'updatedAt'
        ]);

      allow delete: if isOwner(userId);
    }

    match /users/{userId}/binders/{binderId} {
    allow read: if isOwner(userId);

    allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['name', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'createdAt', 'updatedAt'])
        && isNonemptyString(request.resource.data.name)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
